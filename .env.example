# Hugging Face
HUGGINGFACE_API_TOKEN="hf_your_token_here"
# After fine-tuning, set these to your model repo (e.g. your-username/yolos-tiny-ppe-detection)
PRIMARY_MODEL=facebook/detr-resnet-50
SECONDARY_MODEL=facebook/detr-resnet-101

# Database
DATABASE_URL=postgresql+asyncpg://sitewatch:sitewatch@localhost:5432/sitewatch

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

